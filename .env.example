# Copy to .env.local for local development (.env.local is gitignored). Never commit real secrets.
# Everything is optional locally: without values the site uses a local database, logs emails,
# and offers a "Dev sign-in" for /admin.

# Public iCal feed of the "Ahuzat Tzahala Events" Google Calendar. Public, not a secret.
# This is also the built-in default when the variable is not set.
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/123c81be1e033ed38834159a732f300ead0ba52aff9f5c466fce5c9195239efd%40group.calendar.google.com/public/basic.ics

# Supabase Postgres, used only by the server (secret).
# Supabase → Connect → "Direct" tab → Method: "Transaction pooler" (port 6543); put your DB password in it.
# Leave empty locally to use the built-in PGlite database in .data/pglite.
DATABASE_URL=

# Supabase Auth for the admin magic-link login (Supabase → Connect → Framework → Next.js, or
# Project Settings → API Keys). The publishable key (sb_publishable_...) is designed to be public;
# all tables are closed to it by RLS. Older projects can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who may open /admin (comma-separated). Add leaders here too if they should use "Register a resident".
ADMIN_EMAILS=

# Recommended: only these email domains can sign in as students (volunteers see the phone numbers of
# residents booked into their slots, 48 hours before). Comma-separated, e.g. em-is.org. Empty = any email.
STUDENT_EMAIL_DOMAINS=

# Public address of the site, used in emailed links (e.g. https://beyachad-ledorot.vercel.app).
SITE_URL=http://localhost:3000

# Email (sign-in links for students, confirmations). Two options:
#
# 1) Easiest, free, no domain: a Gmail account with an app password (about 500 emails a day).
#    Google Account → Security → turn on 2-Step Verification → App passwords → create one.
#    SMTP_USER = the full Gmail address, SMTP_PASSWORD = the 16-letter app password (spaces are fine).
#    Other mailboxes work too: also set SMTP_HOST (and SMTP_PORT if it isn't 465).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=
#
# 2) Resend (https://resend.com), needs a domain you can verify. Used instead of SMTP when set.
RESEND_API_KEY=
#
# Sender shown on emails, e.g. "EMIS × Ahuzat Tzahala <noreply@your-domain.org>". Optional with Gmail
# (defaults to the project name from config/brand.ts and the Gmail address); required with Resend.
EMAIL_FROM=

# Protects the daily reminder job (/api/cron/daily). Any long random string; Vercel Cron sends it.
CRON_SECRET=

# Not used: the site never needs Supabase's service role key. Don't add SUPABASE_SERVICE_ROLE_KEY.

# Local development only: where the PGlite database lives (default .data/pglite).
# PGLITE_DIR=
